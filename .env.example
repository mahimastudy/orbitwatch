# Server-only credential. Never prefix this with VITE_.
# Create a free key at https://www.n2yo.com/api/
N2YO_API_KEY=your_n2yo_api_key

# Optional: Cesium ion token for future ion terrain/imagery layers
# Create one at https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=your_cesium_ion_token

# Observer location used for pass/position requests (Detroit defaults)
OBSERVER_LATITUDE=42.3314
OBSERVER_LONGITUDE=-83.0458
